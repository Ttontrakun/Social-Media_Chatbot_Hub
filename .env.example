# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงในเครื่องคุณ
# ไฟล์ .env มีความลับ ถูกกันไว้ใน .gitignore ห้าม commit
# สร้างค่าสุ่ม: openssl rand -hex 32

# --- ความลับ (ต้องตั้งเอง ห้ามใช้ค่าตัวอย่างนี้บนระบบจริง) ---
JWT_SECRET=
ENCRYPTION_KEY=

# --- ที่อยู่สาธารณะของระบบ ---
# ใช้สร้าง Webhook URL ที่นำไปวางใน LINE / Meta / X
# ใช้งานจริงต้องเป็น https ที่อินเทอร์เน็ตเข้าถึงได้ และตั้ง COOKIE_SECURE=1
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=0

# --- ฐานข้อมูล (รหัสผ่านตั้งเอง) ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=
POSTGRES_DB=hub

# --- Qdrant ---
# ใส่คีย์เมื่อเปิดการยืนยันตัวตนของ Qdrant ปล่อยว่างได้ถ้าไม่ได้ตั้ง
QDRANT_API_KEY=
QDRANT_COLLECTION=hub_chunks

# --- Embedding ---
# endpoint ที่เข้ากันได้กับ OpenAI เช่น vLLM, Ollama, TEI
# ปล่อย BASE_URL ว่าง = โหมดทดลองในเครื่อง คุณภาพการค้นหาต่ำ ใช้ดูภาพรวมเท่านั้น
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
# ต้องตรงกับขนาดเวกเตอร์ของโมเดล (bge-m3 = 1024)
# ถ้าเปลี่ยนค่านี้หลังมีข้อมูลแล้ว ให้เปลี่ยน QDRANT_COLLECTION เป็นชื่อใหม่ด้วย
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PARALLEL_BATCHES=2

# --- LLM ที่ใช้เรียบเรียงคำตอบ ---
# ปล่อย BASE_URL ว่าง = บอทส่งข้อความดิบจากเอกสารที่ใกล้เคียงที่สุด
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000

# --- Meta (Facebook / Instagram) ---
# META_VERIFY_TOKEN ตั้งเอง แล้วกรอกค่าเดียวกันในหน้า webhook ของ Meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- OCR สำหรับ PDF สแกนและรูปภาพ ---
# ปล่อยว่าง = ไม่ทำ OCR ไฟล์สแกนจะอัปโหลดไม่ผ่านพร้อมข้อความแจ้งเตือน
OCR_API_URL=
OCR_LANG=th
OCR_MAX_PAGES=30
OCR_DPI=200
OCR_MIN_TEXT_CHARS=200
OCR_TIMEOUT_MS=300000

# --- การตัดเอกสารเป็นช่วง ---
TEXT_CHUNK_SIZE=2800
# เพดานความยาวที่ยอมรวมช่วงข้อความกลับเป็นบล็อกเดิม ต้องมากกว่า TEXT_CHUNK_SIZE
PARENT_CHUNK_MAX_CHARS=6000
RAG_QUERY_VARIANT_LIMIT=4

# --- reranker (ไม่บังคับ) ---
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_MS=10000

# --- คำพ้องความหมายเพิ่มเติม (ไม่บังคับ) ---
# รูปแบบ JSON: {"คำในเอกสาร":["คำที่ลูกค้าพิมพ์"]}
RAG_QUERY_SYNONYMS=

# --- อื่น ๆ ---
UPLOAD_MAX_BYTES=20971520
TZ=Asia/Bangkok
